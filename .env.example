# PostgreSQL connection string.
# Local dev example (adjust user/password/db name to your local Postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bot_demo?schema=public"
# On Railway, this is provided automatically when you add the Postgres plugin —
# just reference it as ${{Postgres.DATABASE_URL}} in the app service's variables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bot_demo?schema=public"

# Port the Express server listens on. Railway sets this automatically — leave
# unset in production and let Railway inject its own PORT.
PORT=3000
